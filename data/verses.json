{
  "translation": "思高聖經",
  "note": "經文節錄",
  "verses": [
    {
      "reference": "瑪竇福音 5:4",
      "text": "哀慟的人是有福的，因為他們要受安慰。"
    },
    {
      "reference": "瑪竇福音 5:7",
      "text": "憐憫人的人是有福的，因為他們要受憐憫。"
    },
    {
      "reference": "瑪竇福音 5:8",
      "text": "心裏潔淨的人是有福的，因為他們要看見天主。"
    },
    {
      "reference": "瑪竇福音 5:9",
      "text": "締造和平的人是有福的，因為他們要稱為天主的子女。"
    },
    {
      "reference": "瑪竇福音 5:14",
      "text": "你們是世界的光。"
    },
    {
      "reference": "瑪竇福音 6:6",
      "text": "你幾時祈禱，要進入你的內室，關上門，向你在暗中之父祈禱。"
    },
    {
      "reference": "瑪竇福音 6:8",
      "text": "因為你們的父，在你們求他以前，已知道你們需要什麼。"
    },
    {
      "reference": "瑪竇福音 6:11",
      "text": "我們的日用糧，求你今天賜給我們。"
    },
    {
      "reference": "瑪竇福音 6:21",
      "text": "因為你的財寶在那裏，你的心也必在那裏。"
    },
    {
      "reference": "瑪竇福音 6:33",
      "text": "你們先該尋求天主的國和它的義德，這一切自會加給你們。"
    },
    {
      "reference": "瑪竇福音 6:34",
      "text": "所以你們不要為明天憂慮，因為明天有明天的憂慮。"
    },
    {
      "reference": "瑪竇福音 7:7",
      "text": "你們求，必要給你們；你們找，必要找着；你們敲，必要給你們開。"
    },
    {
      "reference": "瑪竇福音 7:8",
      "text": "因為凡求的，就必得到；找的，就必找到；敲的，就必給他開。"
    },
    {
      "reference": "瑪竇福音 11:28",
      "text": "凡勞苦和負重擔的，你們都到我跟前來，我要使你們安息。"
    },
    {
      "reference": "瑪竇福音 11:29",
      "text": "你們背起我的軛，跟我學罷！因為我是良善心謙的。"
    },
    {
      "reference": "瑪竇福音 11:30",
      "text": "因為我的軛是柔和的，我的擔子是輕鬆的。"
    },
    {
      "reference": "瑪竇福音 18:20",
      "text": "因為那裏有兩個或三個人，因我的名字聚在一起，我就在他們中間。"
    },
    {
      "reference": "瑪竇福音 19:26",
      "text": "為人這是不可能的，但為天主，一切都是可能的。"
    },
    {
      "reference": "瑪竇福音 24:35",
      "text": "天地要過去，但是我的話，決不會過去。"
    },
    {
      "reference": "瑪竇福音 26:41",
      "text": "你們醒寤祈禱罷！免陷於誘惑。"
    },
    {
      "reference": "瑪竇福音 28:20",
      "text": "看！我同你們天天在一起，直到今世的終結。"
    },
    {
      "reference": "馬爾谷福音 5:36",
      "text": "不要怕，只管信。"
    },
    {
      "reference": "馬爾谷福音 9:23",
      "text": "為信的人，一切都是可能的！"
    },
    {
      "reference": "馬爾谷福音 9:24",
      "text": "我信！請你補助我的無信罷！"
    },
    {
      "reference": "馬爾谷福音 11:24",
      "text": "凡你們祈禱，不論求什麼，只要你們相信必得，必給你們成就。"
    },
    {
      "reference": "路加福音 1:37",
      "text": "因為在天主前沒有不能的事。"
    },
    {
      "reference": "路加福音 1:38",
      "text": "看，上主的婢女，願照你的話成就於我罷！"
    },
    {
      "reference": "路加福音 1:46–47",
      "text": "我的靈魂頌揚上主，我的心神歡躍於天主，我的救主。"
    },
    {
      "reference": "路加福音 1:49",
      "text": "因全能者在我身上行了大事，他的名字是聖的。"
    },
    {
      "reference": "路加福音 1:50",
      "text": "他的仁慈世世代代於無窮世，賜與敬畏他的人。"
    },
    {
      "reference": "路加福音 6:36",
      "text": "你們應當慈悲，就像你們的父那樣慈悲。"
    },
    {
      "reference": "路加福音 10:27",
      "text": "你應當全心、全靈、全力、全意愛上主，你的天主；並愛近人如你自己。"
    },
    {
      "reference": "路加福音 12:7",
      "text": "你們不要害怕！你們比許多麻雀尊貴多了。"
    },
    {
      "reference": "路加福音 12:32",
      "text": "你們小小的羊群，不要害怕！因為你們的父喜歡把天國賜給你們。"
    },
    {
      "reference": "路加福音 18:1",
      "text": "應當時常祈禱，不要灰心。"
    },
    {
      "reference": "路加福音 21:36",
      "text": "你們應當時時醒寤祈禱。"
    },
    {
      "reference": "路加福音 22:42",
      "text": "父啊！你如果願意，請給我免去這杯罷！但不要隨我的意願，惟照你的意願成就罷！"
    },
    {
      "reference": "路加福音 23:34",
      "text": "父啊，寬赦他們罷！因為他們不知道他們做的是什麼。"
    },
    {
      "reference": "若望福音 1:5",
      "text": "光在黑暗中照耀，黑暗決不能勝過他。"
    },
    {
      "reference": "若望福音 3:16",
      "text": "天主竟這樣愛了世界，甚至賜下了自己的獨生子。"
    },
    {
      "reference": "若望福音 6:35",
      "text": "我就是生命的食糧；到我這裏來的，永不會飢餓；信從我的，總不會渴。"
    },
    {
      "reference": "若望福音 6:37",
      "text": "凡父交給我的，必到我這裏來；而到我這裏來的，我必不把他拋棄於外。"
    },
    {
      "reference": "若望福音 8:12",
      "text": "我是世界的光；跟隨我的，決不在黑暗中行走，必有生命的光。"
    },
    {
      "reference": "若望福音 8:32",
      "text": "你們也會認識真理，而真理必會使你們獲得自由。"
    },
    {
      "reference": "若望福音 10:10",
      "text": "我卻來，為叫他們獲得生命，且獲得更豐富的生命。"
    },
    {
      "reference": "若望福音 10:11",
      "text": "我是善牧：善牧為羊捨掉自己的性命。"
    },
    {
      "reference": "若望福音 10:27",
      "text": "我的羊聽我的聲音，我認識他們，他們也跟隨我。"
    },
    {
      "reference": "若望福音 11:25",
      "text": "我就是復活，就是生命。"
    },
    {
      "reference": "若望福音 13:34",
      "text": "我給你們一條新命令：你們該彼此相愛。"
    },
    {
      "reference": "若望福音 14:1",
      "text": "你們心裏不要煩亂；你們要信賴天主，也要信賴我。"
    },
    {
      "reference": "若望福音 14:6",
      "text": "我是道路、真理、生命，除非經過我，誰也不能到父那裏去。"
    },
    {
      "reference": "若望福音 14:18",
      "text": "我必不留下你們為孤兒；我要回到你們這裏來。"
    },
    {
      "reference": "若望福音 14:27",
      "text": "我把平安留給你們，我將我的平安賜給你們。"
    },
    {
      "reference": "若望福音 14:27（下）",
      "text": "你們心裏不要煩亂，也不要膽怯。"
    },
    {
      "reference": "若望福音 15:4",
      "text": "你們住在我內，我也住在你們內。"
    },
    {
      "reference": "若望福音 15:5",
      "text": "我是葡萄樹，你們是枝條。"
    },
    {
      "reference": "若望福音 15:9",
      "text": "正如父愛了我，同樣我也愛了你們；你們應存在我的愛內。"
    },
    {
      "reference": "若望福音 15:12",
      "text": "這是我的命令：你們該彼此相愛，如同我愛了你們一樣。"
    },
    {
      "reference": "若望福音 15:13",
      "text": "人若為自己的朋友捨掉性命，再沒有比這更大的愛情了。"
    },
    {
      "reference": "若望福音 16:22",
      "text": "誰也不能從你們奪去你們的喜樂。"
    },
    {
      "reference": "若望福音 16:24",
      "text": "求罷！你們必會得到，好使你們的喜樂得以圓滿。"
    },
    {
      "reference": "若望福音 16:33",
      "text": "你們在世界上要受苦難；然而你們放心，我已戰勝了世界。"
    },
    {
      "reference": "若望福音 20:21",
      "text": "願你們平安！就如父派遣了我，我也同樣派遣你們。"
    },
    {
      "reference": "宗徒大事錄 1:8",
      "text": "當聖神降臨於你們身上時，你們將充滿聖神的德能。"
    },
    {
      "reference": "宗徒大事錄 17:28",
      "text": "因為我們生活、行動、存在，都在他內。"
    },
    {
      "reference": "羅馬書 5:5",
      "text": "望德不叫人蒙羞，因為天主的愛，藉着所賜與我們的聖神，已傾注在我們心中了。"
    },
    {
      "reference": "羅馬書 8:18",
      "text": "現時的苦楚，與將來在我們身上要顯示的光榮，是不能較量的。"
    },
    {
      "reference": "羅馬書 8:26",
      "text": "聖神也扶助我們的軟弱。"
    },
    {
      "reference": "羅馬書 8:28",
      "text": "我們知道，天主使一切協助那些愛他的人，就是那些按他的旨意蒙召的人，獲得益處。"
    },
    {
      "reference": "羅馬書 8:31",
      "text": "若是天主偕同我們，誰能反對我們呢？"
    },
    {
      "reference": "羅馬書 8:35",
      "text": "誰能使我們與基督的愛隔絕？"
    },
    {
      "reference": "羅馬書 12:12",
      "text": "論望德，要喜樂；在困苦中，要忍耐；在祈禱上，要恆心。"
    },
    {
      "reference": "羅馬書 12:21",
      "text": "你不可為惡所勝，反應以善勝惡。"
    },
    {
      "reference": "羅馬書 15:13",
      "text": "願賜望德的天主，因着你們的信心，使你們充滿各種喜樂與平安。"
    },
    {
      "reference": "格林多前書 3:16",
      "text": "你們不知道，你們是天主的宮殿，天主聖神住在你們內嗎？"
    },
    {
      "reference": "格林多前書 13:4",
      "text": "愛是含忍的，愛是慈祥的，愛不嫉妒，不誇張，不自大。"
    },
    {
      "reference": "格林多前書 13:7",
      "text": "凡事包容，凡事相信，凡事盼望，凡事忍耐。"
    },
    {
      "reference": "格林多前書 13:8",
      "text": "愛永存不朽。"
    },
    {
      "reference": "格林多前書 13:13",
      "text": "現今存在的，有信、望、愛這三樣，但其中最大的是愛。"
    },
    {
      "reference": "格林多前書 16:14",
      "text": "你們的一切事，都應以愛而行。"
    },
    {
      "reference": "格林多後書 1:4",
      "text": "他在我們的各種磨難中，常安慰我們。"
    },
    {
      "reference": "格林多後書 5:7",
      "text": "因為我們現今是憑信德往來，並不是憑目見。"
    },
    {
      "reference": "格林多後書 12:9",
      "text": "有我的恩寵為你夠了，因為我的德能在軟弱中才全顯出來。"
    },
    {
      "reference": "迦拉達書 5:22–23",
      "text": "聖神的效果卻是：仁愛、喜樂、平安、忍耐、良善、溫和、忠信、柔和、節制。"
    },
    {
      "reference": "迦拉達書 6:9",
      "text": "為此，我們行善不要厭倦；如果不鬆懈，到了適當的時節，必可收穫。"
    },
    {
      "reference": "厄弗所書 4:32",
      "text": "你們彼此相待，要良善，要仁慈，互相寬恕，如同天主在基督內寬恕了你們一樣。"
    },
    {
      "reference": "厄弗所書 6:18",
      "text": "你們要時時靠着聖神，以各種祈求和哀禱祈禱。"
    },
    {
      "reference": "斐理伯書 4:4",
      "text": "你們在主內應當常常喜樂，我再說：你們應當喜樂！"
    },
    {
      "reference": "斐理伯書 4:6",
      "text": "你們什麼也不要掛慮，只在一切事上，以懇求和祈禱，懷着感謝之心，向天主呈上你們的請求。"
    },
    {
      "reference": "斐理伯書 4:7",
      "text": "天主那超越各種意想的平安，必要在基督耶穌內固守你們的心思念慮。"
    },
    {
      "reference": "斐理伯書 4:13",
      "text": "我賴加強我力量的那位，能應付一切。"
    },
    {
      "reference": "哥羅森書 3:15",
      "text": "還要叫基督的平安，在你們心中作主。"
    },
    {
      "reference": "哥羅森書 4:2",
      "text": "你們應恆心祈禱，在祈禱中要醒寤，要謝恩。"
    },
    {
      "reference": "得撒洛尼前書 5:16–18",
      "text": "應常歡樂，不斷祈禱，事事感謝。"
    },
    {
      "reference": "弟茂德後書 1:7",
      "text": "天主所賜給我們的，並非怯懦之神，而是大能、愛德和慎重之神。"
    },
    {
      "reference": "希伯來書 4:16",
      "text": "所以我們要懷着依恃之心，走近恩寵的寶座，以獲得仁慈，尋得恩寵，作為及時的扶助。"
    },
    {
      "reference": "希伯來書 13:8",
      "text": "耶穌基督，昨天、今天、直到永遠，常是一樣。"
    },
    {
      "reference": "雅各伯書 4:8",
      "text": "你們要親近天主，天主就必親近你們。"
    },
    {
      "reference": "伯多祿前書 5:7",
      "text": "將你們的一切掛慮都託給他，因為他必關照你們。"
    },
    {
      "reference": "若望一書 4:19",
      "text": "我們應該愛，因為天主先愛了我們。"
    }
  ]
}
